# Bank Statement Analyzer — Environment Variables
# Copy this file to .env and fill in the values for production.
#
# IMPORTANT: Never commit the actual .env file to version control.
# The .gitignore already excludes .env.

# Flask Secret Key (REQUIRED for production)
# Generate a secure random key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# If not set, a random key is generated at startup (sessions won't persist across restarts).
SECRET_KEY=your-secure-random-key-here
